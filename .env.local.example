# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 6-digit code given to the couple. Server-side only - never exposed to the browser.
COUPLE_PASSCODE=

# Deployed site URL, used by the QR generator.
NEXT_PUBLIC_SITE_URL=https://your-wedding.vercel.app

# Optional. Only needed for photo moderation (hide/unhide) in /couple.
# Supabase project settings -> API -> service_role. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
